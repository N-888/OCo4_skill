# Игнорируем виртуальное окружение
venv/

# Игнорируем кэш Python
__pycache__/
*.py[cod]
*$py.class

# Игнорируем кэш тестов
.pytest_cache/

# Игнорируем локальные JSON-файлы с реальными данными
*.local.json
config.local.json

# Игнорируем файлы с локальными путями
*.local

# Игнорируем временные файлы
*.tmp
*.temp

# Игнорируем файлы логов
*.log

# Игнорируем файлы ошибок
*.error

# Игнорируем системные файлы macOS
.DS_Store

# Игнорируем системные файлы Windows
Thumbs.db
ehthumbs.db

# Игнорируем файлы IDE
.vscode/
.idea/
*.swp
*.swo

# Игнорируем файлы зависимостей
node_modules/
package-lock.json

# Игнорируем собранные файлы
dist/
build/
*.egg-info/